layout {

    focus-ring {
        active-color   "#8bc1bd"
        inactive-color "#1a2323"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#8bc1bd"
        inactive-color "#1a2323"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#8bc1bd"
        inactive-color "#2f6a66"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#8bc1bd80"
    }
}

recent-windows {
    highlight {
        active-color "#8bc1bd"
        urgent-color "#fd4663"
    }
}
